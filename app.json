{
  "expo": {
    "name": "trekkez2",
    "slug": "trekkez2",
    "scheme": "trekkez2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4cc2fe"
      },
      "package": "com.leduong232steam.trekkez2",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "$RNMAPBOX_MAPS_DOWNLOAD_TOKEN"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép Trekkez truy cập vị trí của bạn để hiển thị bản đồ và dẫn đường."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08f18841-01e1-4b1b-81a6-ed5881f98ac4"
      }
    },
    "owner": "leduong232s-team"
  }
}