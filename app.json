{
  "expo": {
    "name": "TrekkEZ",
    "slug": "trekkez2",
    "scheme": "trekkez2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/trekkEZ.png",
        "backgroundColor": "#79d3ff"
      },
      "package": "com.leduong232steam.trekkez2",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps"
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Trekkez to access your location for map display and navigation."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Trekkez to access your camera to take photos.",
          "microphonePermission": "Allow Trekkez to access your microphone to record videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Trekkez to access your photo library to select photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Trekkez to access your photo library to load and select photos.",
          "savePhotosPermission": "Allow Trekkez to save photos to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08f18841-01e1-4b1b-81a6-ed5881f98ac4"
      }
    },
    "owner": "leduong232s-team"
  }
}